generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/cms-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  RESOLVED
  CANCELLED
}

enum ContactMessageStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum HomepageSectionType {
  HERO
  ABOUT
  FEATURED_DEPARTMENTS
  CENTRES_OF_EXCELLENCE
  FEATURED_DOCTORS
  SPECIALITIES
  SERVICES
  HEALTH_PACKAGES
  TESTIMONIALS
  SUCCESS_STORIES
  NEWS
  HEALTH_LIBRARY
  TRUST
  CONTACT_CTA
}

enum MediaType {
  IMAGE
  DOCUMENT
  VIDEO
  OTHER
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  email          String          @unique
  passwordHash   String
  role           Role
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?
}

model PatientProfile {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @unique @db.Uuid
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName         String
  phoneNumber      String
  dateOfBirth      DateTime      @db.Date
  gender           String
  emergencyContact String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  appointments     Appointment[]

  @@index([userId])
}

model Department {
  id               String          @id @default(uuid()) @db.Uuid
  name             String          @unique
  slug             String          @unique
  description      String?
  shortDescription String?
  fullDescription  String?
  imageUrl         String?
  icon             String?
  displayOrder     Int             @default(0)
  isFeatured       Boolean         @default(false)
  seoTitle         String?
  seoDescription   String?
  contentStatus    ContentStatus   @default(PUBLISHED)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  doctors          DoctorProfile[]
  specialities     Speciality[]
  appointmentEnquiries AppointmentEnquiry[]

  @@index([isActive, contentStatus, displayOrder])
}

model DoctorProfile {
  id                   String               @id @default(uuid()) @db.Uuid
  userId               String               @unique @db.Uuid
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId         String               @db.Uuid
  department           Department           @relation(fields: [departmentId], references: [id])
  fullName             String
  slug                 String               @unique
  phoneNumber          String
  qualification        String
  experienceYears      Int                  @default(0)
  bio                  String?
  profileImageUrl      String?
  publicDisplayName    String?
  designation          String?
  languages            String?
  publicBio            String?
  education            String?
  certifications       String?
  memberships          String?
  areasOfInterest      String?
  displayOrder         Int                  @default(0)
  isFeatured           Boolean              @default(false)
  seoTitle             String?
  seoDescription       String?
  contentStatus        ContentStatus        @default(PUBLISHED)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  weeklyAvailabilities WeeklyAvailability[]
  blockedDates         BlockedDate[]
  appointments         Appointment[]
  specialities         DoctorSpeciality[]
  centres              DoctorCentre[]
  successStories       SuccessStory[]
  appointmentEnquiries AppointmentEnquiry[]

  @@index([userId])
  @@index([departmentId])
  @@index([contentStatus, isFeatured, displayOrder])
}

model WeeklyAvailability {
  id                  String        @id @default(uuid()) @db.Uuid
  doctorId            String        @db.Uuid
  doctor              DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek           Int
  startTime           String
  endTime             String
  slotDurationMinutes Int           @default(30)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([doctorId, dayOfWeek])
}

model BlockedDate {
  id        String        @id @default(uuid()) @db.Uuid
  doctorId  String        @db.Uuid
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startDate DateTime      @db.Date
  endDate   DateTime      @db.Date
  startTime String?
  endTime   String?
  reason    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([doctorId, startDate, endDate])
}

model Appointment {
  id                 String            @id @default(uuid()) @db.Uuid
  patientId          String            @db.Uuid
  patient            PatientProfile    @relation(fields: [patientId], references: [id])
  doctorId           String            @db.Uuid
  doctor             DoctorProfile     @relation(fields: [doctorId], references: [id])
  appointmentDate    DateTime          @db.Date
  startTime          String
  endTime            String
  status             AppointmentStatus @default(BOOKED)
  reason             String?
  cancellationReason String?
  cancelledBy        Role?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([patientId, appointmentDate])
  @@index([doctorId, appointmentDate])
  @@index([doctorId, appointmentDate, status])
}

// ─── Public hospital CMS ───────────────────────────────────────────────

model HospitalProfile {
  id               String   @id @default(uuid()) @db.Uuid
  hospitalName     String
  legalName        String?
  shortDescription String?
  fullDescription  String?
  tagline          String?
  phone            String?
  emergencyPhone   String?
  email            String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  country          String?  @default("India")
  latitude         Float?
  longitude        Float?
  timezone         String?  @default("Asia/Kolkata")
  websiteUrl       String?
  logoUrl          String?
  heroImageUrl     String?
  mission          String?
  vision           String?
  values           String?
  workingHours     String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model HospitalLocation {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  slug           String        @unique
  address        String
  city           String
  state          String
  postalCode     String?
  phone          String?
  emergencyPhone String?
  email          String?
  latitude       Float?
  longitude      Float?
  mapUrl         String?
  directionsUrl  String?
  seoTitle       String?
  seoDescription String?
  contentStatus  ContentStatus @default(PUBLISHED)
  isPrimary      Boolean       @default(false)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([isActive, contentStatus])
}

model LeadershipMember {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  slug          String        @unique
  designation   String
  shortBio      String?
  fullBio       String?
  imageUrl      String?
  displayOrder  Int           @default(0)
  contentStatus ContentStatus @default(PUBLISHED)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([isActive, contentStatus, displayOrder])
}

model Facility {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  slug          String        @unique
  description   String?
  imageUrl      String?
  category      String?
  displayOrder  Int           @default(0)
  contentStatus ContentStatus @default(PUBLISHED)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([isActive, contentStatus, displayOrder])
}

model Speciality {
  id               String          @id @default(uuid()) @db.Uuid
  name             String          @unique
  slug             String          @unique
  shortDescription String?
  fullDescription  String?
  imageUrl         String?
  icon             String?
  departmentId     String?         @db.Uuid
  department       Department?     @relation(fields: [departmentId], references: [id])
  displayOrder     Int             @default(0)
  isFeatured       Boolean         @default(false)
  seoTitle         String?
  seoDescription   String?
  contentStatus    ContentStatus   @default(PUBLISHED)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  doctors          DoctorSpeciality[]
  centres          CentreSpeciality[]
  articles         HealthArticle[]
  successStories   SuccessStory[]
  testimonials     Testimonial[]

  @@index([isActive, contentStatus, displayOrder])
  @@index([departmentId])
}

model CentreOfExcellence {
  id               String        @id @default(uuid()) @db.Uuid
  name             String        @unique
  slug             String        @unique
  shortDescription String?
  fullDescription  String?
  clinicalFocus    String?
  heroImageUrl     String?
  icon             String?
  displayOrder     Int           @default(0)
  isFeatured       Boolean       @default(false)
  seoTitle         String?
  seoDescription   String?
  contentStatus    ContentStatus @default(PUBLISHED)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  specialities     CentreSpeciality[]
  doctors          DoctorCentre[]
  services         CentreService[]

  @@index([isActive, contentStatus, displayOrder])
}

model DoctorSpeciality {
  doctorId     String        @db.Uuid
  specialityId String        @db.Uuid
  doctor       DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  speciality   Speciality    @relation(fields: [specialityId], references: [id], onDelete: Cascade)

  @@id([doctorId, specialityId])
}

model DoctorCentre {
  doctorId String             @db.Uuid
  centreId String             @db.Uuid
  doctor   DoctorProfile      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  centre   CentreOfExcellence @relation(fields: [centreId], references: [id], onDelete: Cascade)

  @@id([doctorId, centreId])
}

model CentreSpeciality {
  centreId     String             @db.Uuid
  specialityId String             @db.Uuid
  centre       CentreOfExcellence @relation(fields: [centreId], references: [id], onDelete: Cascade)
  speciality   Speciality         @relation(fields: [specialityId], references: [id], onDelete: Cascade)

  @@id([centreId, specialityId])
}

model HospitalService {
  id               String          @id @default(uuid()) @db.Uuid
  name             String          @unique
  slug             String          @unique
  shortDescription String?
  fullDescription  String?
  imageUrl         String?
  icon             String?
  displayOrder     Int             @default(0)
  seoTitle         String?
  seoDescription   String?
  contentStatus    ContentStatus   @default(PUBLISHED)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  centres          CentreService[]

  @@index([isActive, contentStatus, displayOrder])
}

model CentreService {
  centreId  String             @db.Uuid
  serviceId String             @db.Uuid
  centre    CentreOfExcellence @relation(fields: [centreId], references: [id], onDelete: Cascade)
  service   HospitalService    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([centreId, serviceId])
}

model HealthPackage {
  id                      String        @id @default(uuid()) @db.Uuid
  name                    String
  slug                    String        @unique
  description             String?
  detailedDescription     String?
  imageUrl                String?
  price                   Decimal?      @db.Decimal(10, 2)
  currency                String?       @default("INR")
  duration                String?
  eligibility             String?
  includedItems           String?
  preparationInstructions String?
  isDemoPricing           Boolean       @default(true)
  displayOrder            Int           @default(0)
  seoTitle                String?
  seoDescription          String?
  contentStatus           ContentStatus @default(PUBLISHED)
  isActive                Boolean       @default(true)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([isActive, contentStatus, displayOrder])
}

model HealthArticle {
  id             String        @id @default(uuid()) @db.Uuid
  title          String
  slug           String        @unique
  excerpt        String?
  content        String
  coverImageUrl  String?
  author         String?
  specialityId   String?       @db.Uuid
  speciality     Speciality?   @relation(fields: [specialityId], references: [id])
  tags           String?
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  contentStatus  ContentStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([contentStatus, publishedAt])
  @@index([specialityId])
}

model NewsArticle {
  id             String        @id @default(uuid()) @db.Uuid
  title          String
  slug           String        @unique
  excerpt        String?
  content        String
  coverImageUrl  String?
  category       String?
  author         String?
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  contentStatus  ContentStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([contentStatus, publishedAt])
}

model SuccessStory {
  id                 String         @id @default(uuid()) @db.Uuid
  title              String
  slug               String         @unique
  summary            String?
  content            String
  patientDisplayName String
  ageGroup           String?
  specialityId       String?        @db.Uuid
  speciality         Speciality?    @relation(fields: [specialityId], references: [id])
  doctorId           String?        @db.Uuid
  doctor             DoctorProfile? @relation(fields: [doctorId], references: [id])
  imageUrl           String?
  videoUrl           String?
  isAnonymizedDemo   Boolean        @default(true)
  publishedAt        DateTime?
  seoTitle           String?
  seoDescription     String?
  contentStatus      ContentStatus  @default(DRAFT)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([contentStatus, publishedAt])
}

model Testimonial {
  id            String        @id @default(uuid()) @db.Uuid
  displayName   String
  text          String
  rating        Int           @default(5)
  specialityId  String?       @db.Uuid
  speciality    Speciality?   @relation(fields: [specialityId], references: [id])
  imageUrl      String?
  publishedAt   DateTime?
  isDemoContent Boolean       @default(true)
  displayOrder  Int           @default(0)
  contentStatus ContentStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([contentStatus, displayOrder])
}

model FaqItem {
  id            String        @id @default(uuid()) @db.Uuid
  question      String
  answer        String
  category      String?
  displayOrder  Int           @default(0)
  contentStatus ContentStatus @default(PUBLISHED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([contentStatus, displayOrder])
}

model PatientResource {
  id            String        @id @default(uuid()) @db.Uuid
  title         String
  slug          String        @unique
  description   String?
  fileUrl       String?
  category      String?
  displayOrder  Int           @default(0)
  contentStatus ContentStatus @default(PUBLISHED)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([isActive, contentStatus, displayOrder])
}

model InsurancePartner {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  slug          String        @unique
  logoUrl       String?
  description   String?
  displayOrder  Int           @default(0)
  contentStatus ContentStatus @default(PUBLISHED)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([isActive, contentStatus, displayOrder])
}

model InternationalPageContent {
  id                   String   @id @default(uuid()) @db.Uuid
  title                String
  introduction         String?
  howToRequest         String?
  secondOpinion        String?
  requiredDocuments    String?
  travelInformation    String?
  accommodationInfo    String?
  coordinatorContact   String?
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}

model HomepageSection {
  id           String              @id @default(uuid()) @db.Uuid
  sectionType  HomepageSectionType
  title        String?
  subtitle     String?
  content      String?
  imageUrl     String?
  displayOrder Int                 @default(0)
  isEnabled    Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([isEnabled, displayOrder])
}

model MediaAsset {
  id        String    @id @default(uuid()) @db.Uuid
  url       String
  altText   String?
  caption   String?
  type      MediaType @default(IMAGE)
  width     Int?
  height    Int?
  createdAt DateTime  @default(now())
}

model AppointmentEnquiry {
  id                String         @id @default(uuid()) @db.Uuid
  name              String
  email             String
  phone             String
  departmentId      String?        @db.Uuid
  department        Department?    @relation(fields: [departmentId], references: [id])
  preferredDoctorId String?        @db.Uuid
  preferredDoctor   DoctorProfile? @relation(fields: [preferredDoctorId], references: [id])
  preferredDate     DateTime?      @db.Date
  message           String?
  status            EnquiryStatus  @default(NEW)
  internalNotes     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status, createdAt])
}

model ContactMessage {
  id        String               @id @default(uuid()) @db.Uuid
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
}

model InternationalPatientEnquiry {
  id                  String        @id @default(uuid()) @db.Uuid
  name                String
  email               String
  phone               String?
  country             String
  treatmentInterest   String?
  preferredDepartment String?
  message             String?
  status              EnquiryStatus @default(NEW)
  internalNotes       String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([status, createdAt])
}

model PackageInformationRequest {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  email            String
  phone            String?
  packageSlug      String?
  packageName      String?
  message          String?
  status           EnquiryStatus @default(NEW)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, createdAt])
}
