generator client {
  provider = "prisma-client-js"
  previewFeatures = ["metrics"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  RESOLVED
  CANCELLED
}

enum ContactMessageStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_REMINDER
  DOCTOR_SCHEDULE_CHANGE
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum HomepageSectionType {
  HERO
  ABOUT
  FEATURED_DEPARTMENTS
  CENTRES_OF_EXCELLENCE
  FEATURED_DOCTORS
  SPECIALITIES
  SERVICES
  HEALTH_PACKAGES
  TESTIMONIALS
  SUCCESS_STORIES
  NEWS
  HEALTH_LIBRARY
  TRUST
  CONTACT_CTA
}

enum MediaType {
  IMAGE
  DOCUMENT
  VIDEO
  OTHER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?
  notifications  Notification[]
  auditLogs      AuditLog[]

  tenantId String          @db.Uuid
  tenant   HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId])
}

model PatientProfile {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  user             User     @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  fullName         String
  phoneNumber      String
  dateOfBirth      DateTime @db.Date
  gender           String
  emergencyContact String?
  abhaNumber       String?  @unique // ABDM Integration
  abhaAddress      String?  @unique // ABDM Integration
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  appointments Appointment[]
  tenantId     String          @db.Uuid
  tenant       HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

model Department {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  slug             String
  description      String?
  shortDescription String?
  fullDescription  String?
  imageUrl         String?
  icon             String?
  displayOrder     Int           @default(0)
  isFeatured       Boolean       @default(false)
  seoTitle         String?
  seoDescription   String?
  contentStatus    ContentStatus @default(PUBLISHED)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  doctors              DoctorProfile[]
  specialities         Speciality[]
  appointmentEnquiries AppointmentEnquiry[]
  tenantId             String               @db.Uuid
  tenant               HospitalProfile      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@unique([tenantId, slug])
  @@index([isActive, contentStatus, displayOrder])
  @@index([tenantId])
}

model DoctorProfile {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @unique @db.Uuid
  user              User          @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  departmentId      String        @db.Uuid
  department        Department    @relation(fields: [departmentId, tenantId], references: [id, tenantId])
  fullName          String
  slug              String
  phoneNumber       String
  qualification     String
  experienceYears   Int           @default(0)
  bio               String?
  profileImageUrl   String?
  publicDisplayName String?
  designation       String?
  languages         String?
  publicBio         String?
  education         String?
  certifications    String?
  memberships       String?
  areasOfInterest   String?
  displayOrder      Int           @default(0)
  isFeatured        Boolean       @default(false)
  seoTitle          String?
  seoDescription    String?
  contentStatus     ContentStatus @default(PUBLISHED)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  weeklyAvailabilities WeeklyAvailability[]
  blockedDates         BlockedDate[]
  appointments         Appointment[]
  specialities         DoctorSpeciality[]
  centres              DoctorCentre[]
  successStories       SuccessStory[]
  appointmentEnquiries AppointmentEnquiry[]
  tenantId             String               @db.Uuid
  tenant               HospitalProfile      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([userId, tenantId])
  @@unique([tenantId, slug])
  @@index([userId])
  @@index([departmentId])
  @@index([tenantId])
  @@index([contentStatus, isFeatured, displayOrder])
}

model WeeklyAvailability {
  id                  String          @id @default(uuid()) @db.Uuid
  doctorId            String          @db.Uuid
  doctor              DoctorProfile   @relation(fields: [doctorId, tenantId], references: [id, tenantId], onDelete: Cascade)
  dayOfWeek           Int
  startTime           String
  endTime             String
  slotDurationMinutes Int             @default(30)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  tenantId            String          @db.Uuid
  tenant              HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([doctorId, dayOfWeek])
  @@index([tenantId])
}

model BlockedDate {
  id        String          @id @default(uuid()) @db.Uuid
  doctorId  String          @db.Uuid
  doctor    DoctorProfile   @relation(fields: [doctorId, tenantId], references: [id, tenantId], onDelete: Cascade)
  startDate DateTime        @db.Date
  endDate   DateTime        @db.Date
  startTime String?
  endTime   String?
  reason    String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  tenantId  String          @db.Uuid
  tenant    HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([doctorId, startDate, endDate])
  @@index([tenantId])
}

model Appointment {
  id                 String            @id @default(uuid()) @db.Uuid
  patientId          String            @db.Uuid
  patient            PatientProfile    @relation(fields: [patientId, tenantId], references: [id, tenantId])
  doctorId           String            @db.Uuid
  doctor             DoctorProfile     @relation(fields: [doctorId, tenantId], references: [id, tenantId])
  appointmentDate    DateTime          @db.Date
  startTime          String
  endTime            String
  status             AppointmentStatus @default(BOOKED)
  reason             String?
  cancellationReason String?
  cancelledBy        Role?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  notifications Notification[]
  tenantId      String          @db.Uuid
  tenant        HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([patientId, appointmentDate])
  @@index([doctorId, appointmentDate])
  @@index([doctorId, appointmentDate, status])
  @@index([tenantId])
}

// ─── Public hospital CMS ───────────────────────────────────────────────

model HospitalProfile {
  id                            String                        @id @default(uuid()) @db.Uuid
  hospitalName                  String
  legalName                     String?
  shortDescription              String?
  fullDescription               String?
  tagline                       String?
  phone                         String?
  emergencyPhone                String?
  email                         String?
  addressLine1                  String?
  addressLine2                  String?
  city                          String?
  state                         String?
  postalCode                    String?
  country                       String?                       @default("India")
  latitude                      Float?
  longitude                     Float?
  timezone                      String?                       @default("Asia/Kolkata")
  websiteUrl                    String?
  hfrId                         String?                       @unique // ABDM Integration
  logoUrl                       String?
  heroImageUrl                  String?

  // Domain Mapping
  customDomain                  String?                       @unique // e.g. "hospital-a.com"
  subdomain                     String?                       @unique // e.g. "tenant-a.platform.com"

  // Branding Colors
  primaryColor                  String?                       @default("#0ea5e9") // Brand Blue
  secondaryColor                String?                       @default("#f43f5e") // Rose/Red

  // Fonts
  fontFamily                    String?                       @default("Inter, sans-serif")

  // Social Links
  facebookUrl                   String?
  twitterUrl                    String?
  instagramUrl                  String?
  linkedinUrl                   String?

  mission                       String?
  vision                        String?
  values                        String?
  workingHours                  String?
  isActive                      Boolean                       @default(true)
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt
  users                         User[]
  patientProfiles               PatientProfile[]
  departments                   Department[]
  doctorProfiles                DoctorProfile[]
  hospitalLocations             HospitalLocation[]
  leadershipMembers             LeadershipMember[]
  facilities                    Facility[]
  centreOfExcellences           CentreOfExcellence[]
  hospitalServices              HospitalService[]
  healthPackages                HealthPackage[]
  healthArticles                HealthArticle[]
  newsArticles                  NewsArticle[]
  faqItems                      FaqItem[]
  patientResources              PatientResource[]
  insurancePartners             InsurancePartner[]
  internationalPageContents     InternationalPageContent[]
  homepageSections              HomepageSection[]
  mediaAssets                   MediaAsset[]
  contactMessages               ContactMessage[]
  internationalPatientEnquiries InternationalPatientEnquiry[]
  packageInformationRequests    PackageInformationRequest[]
  weeklyAvailabilities          WeeklyAvailability[]
  blockedDates                  BlockedDate[]
  appointments                  Appointment[]
  specialities                  Speciality[]
  successStories                SuccessStory[]
  testimonials                  Testimonial[]
  appointmentEnquiries          AppointmentEnquiry[]
  notifications                 Notification[]
  otpChallenges                 OtpChallenge[]
  auditLogs                     AuditLog[]
  authAttempts                  AuthAttempt[]
}

model HospitalLocation {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  slug           String
  address        String
  city           String
  state          String
  postalCode     String?
  phone          String?
  emergencyPhone String?
  email          String?
  latitude       Float?
  longitude      Float?
  mapUrl         String?
  directionsUrl  String?
  seoTitle       String?
  seoDescription String?
  contentStatus  ContentStatus   @default(PUBLISHED)
  isPrimary      Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenantId       String          @db.Uuid
  tenant         HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([isActive, contentStatus])
  @@index([tenantId])
}

model LeadershipMember {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  slug          String
  designation   String
  shortBio      String?
  fullBio       String?
  imageUrl      String?
  displayOrder  Int             @default(0)
  contentStatus ContentStatus   @default(PUBLISHED)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tenantId      String          @db.Uuid
  tenant        HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([isActive, contentStatus, displayOrder])
  @@index([tenantId])
}

model Facility {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  slug          String
  description   String?
  imageUrl      String?
  category      String?
  displayOrder  Int             @default(0)
  contentStatus ContentStatus   @default(PUBLISHED)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tenantId      String          @db.Uuid
  tenant        HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([isActive, contentStatus, displayOrder])
  @@index([tenantId])
}

model Speciality {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  slug             String
  shortDescription String?
  fullDescription  String?
  imageUrl         String?
  icon             String?
  departmentId     String?       @db.Uuid
  // Optional parent: PostgreSQL composite FK MATCH SIMPLE enforces tenant match when set.
  department       Department?   @relation(fields: [departmentId], references: [id])
  displayOrder     Int           @default(0)
  isFeatured       Boolean       @default(false)
  seoTitle         String?
  seoDescription   String?
  contentStatus    ContentStatus @default(PUBLISHED)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  doctors        DoctorSpeciality[]
  centres        CentreSpeciality[]
  articles       HealthArticle[]
  successStories SuccessStory[]
  testimonials   Testimonial[]
  tenantId       String             @db.Uuid
  tenant         HospitalProfile    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@unique([tenantId, slug])
  @@index([isActive, contentStatus, displayOrder])
  @@index([departmentId])
  @@index([tenantId])
}

model CentreOfExcellence {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  slug             String
  shortDescription String?
  fullDescription  String?
  clinicalFocus    String?
  heroImageUrl     String?
  icon             String?
  displayOrder     Int           @default(0)
  isFeatured       Boolean       @default(false)
  seoTitle         String?
  seoDescription   String?
  contentStatus    ContentStatus @default(PUBLISHED)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  specialities CentreSpeciality[]
  doctors      DoctorCentre[]
  services     CentreService[]
  tenantId     String             @db.Uuid
  tenant       HospitalProfile    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@unique([tenantId, slug])
  @@index([isActive, contentStatus, displayOrder])
  @@index([tenantId])
}

model DoctorSpeciality {
  doctorId     String        @db.Uuid
  specialityId String        @db.Uuid
  tenantId     String        @db.Uuid
  doctor       DoctorProfile @relation(fields: [doctorId, tenantId], references: [id, tenantId], onDelete: Cascade)
  speciality   Speciality    @relation(fields: [specialityId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([doctorId, specialityId])
  @@index([tenantId])
}

model DoctorCentre {
  doctorId String             @db.Uuid
  centreId String             @db.Uuid
  tenantId String             @db.Uuid
  doctor   DoctorProfile      @relation(fields: [doctorId, tenantId], references: [id, tenantId], onDelete: Cascade)
  centre   CentreOfExcellence @relation(fields: [centreId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([doctorId, centreId])
  @@index([tenantId])
}

model CentreSpeciality {
  centreId     String             @db.Uuid
  specialityId String             @db.Uuid
  tenantId     String             @db.Uuid
  centre       CentreOfExcellence @relation(fields: [centreId, tenantId], references: [id, tenantId], onDelete: Cascade)
  speciality   Speciality         @relation(fields: [specialityId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([centreId, specialityId])
  @@index([tenantId])
}

model HospitalService {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  slug             String
  shortDescription String?
  fullDescription  String?
  imageUrl         String?
  icon             String?
  displayOrder     Int           @default(0)
  seoTitle         String?
  seoDescription   String?
  contentStatus    ContentStatus @default(PUBLISHED)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  centres  CentreService[]
  tenantId String          @db.Uuid
  tenant   HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@unique([tenantId, slug])
  @@index([isActive, contentStatus, displayOrder])
  @@index([tenantId])
}

model CentreService {
  centreId  String             @db.Uuid
  serviceId String             @db.Uuid
  tenantId  String             @db.Uuid
  centre    CentreOfExcellence @relation(fields: [centreId, tenantId], references: [id, tenantId], onDelete: Cascade)
  service   HospitalService    @relation(fields: [serviceId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([centreId, serviceId])
  @@index([tenantId])
}

model HealthPackage {
  id                      String          @id @default(uuid()) @db.Uuid
  name                    String
  slug                    String
  description             String?
  detailedDescription     String?
  imageUrl                String?
  price                   Decimal?        @db.Decimal(10, 2)
  currency                String?         @default("INR")
  duration                String?
  eligibility             String?
  includedItems           String?
  preparationInstructions String?
  isDemoPricing           Boolean         @default(true)
  displayOrder            Int             @default(0)
  seoTitle                String?
  seoDescription          String?
  contentStatus           ContentStatus   @default(PUBLISHED)
  isActive                Boolean         @default(true)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  tenantId                String          @db.Uuid
  tenant                  HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([isActive, contentStatus, displayOrder])
  @@index([tenantId])
}

model HealthArticle {
  id             String          @id @default(uuid()) @db.Uuid
  title          String
  slug           String
  excerpt        String?
  content        String
  coverImageUrl  String?
  author         String?
  specialityId   String?         @db.Uuid
  speciality     Speciality?     @relation(fields: [specialityId], references: [id])
  tags           String?
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  contentStatus  ContentStatus   @default(DRAFT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenantId       String          @db.Uuid
  tenant         HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, slug])
  @@index([contentStatus, publishedAt])
  @@index([specialityId])
  @@index([tenantId])
}

model NewsArticle {
  id             String          @id @default(uuid()) @db.Uuid
  title          String
  slug           String
  excerpt        String?
  content        String
  coverImageUrl  String?
  category       String?
  author         String?
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  contentStatus  ContentStatus   @default(DRAFT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenantId       String          @db.Uuid
  tenant         HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([contentStatus, publishedAt])
  @@index([tenantId])
}

model SuccessStory {
  id                 String          @id @default(uuid()) @db.Uuid
  title              String
  slug               String
  summary            String?
  content            String
  patientDisplayName String
  ageGroup           String?
  specialityId       String?         @db.Uuid
  speciality         Speciality?     @relation(fields: [specialityId], references: [id])
  doctorId           String?         @db.Uuid
  doctor             DoctorProfile?  @relation(fields: [doctorId], references: [id])
  imageUrl           String?
  videoUrl           String?
  isAnonymizedDemo   Boolean         @default(true)
  publishedAt        DateTime?
  seoTitle           String?
  seoDescription     String?
  contentStatus      ContentStatus   @default(DRAFT)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  tenantId           String          @db.Uuid
  tenant             HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, slug])
  @@index([contentStatus, publishedAt])
  @@index([tenantId])
}

model Testimonial {
  id            String          @id @default(uuid()) @db.Uuid
  displayName   String
  text          String
  rating        Int             @default(5)
  specialityId  String?         @db.Uuid
  speciality    Speciality?     @relation(fields: [specialityId], references: [id])
  imageUrl      String?
  publishedAt   DateTime?
  isDemoContent Boolean         @default(true)
  displayOrder  Int             @default(0)
  contentStatus ContentStatus   @default(DRAFT)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tenantId      String          @db.Uuid
  tenant        HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([contentStatus, displayOrder])
  @@index([tenantId])
  @@unique([id, tenantId])
}

model FaqItem {
  id            String          @id @default(uuid()) @db.Uuid
  question      String
  answer        String
  category      String?
  displayOrder  Int             @default(0)
  contentStatus ContentStatus   @default(PUBLISHED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tenantId      String          @db.Uuid
  tenant        HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([contentStatus, displayOrder])
  @@index([tenantId])
}

model PatientResource {
  id            String          @id @default(uuid()) @db.Uuid
  title         String
  slug          String
  description   String?
  fileUrl       String?
  category      String?
  displayOrder  Int             @default(0)
  contentStatus ContentStatus   @default(PUBLISHED)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tenantId      String          @db.Uuid
  tenant        HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([isActive, contentStatus, displayOrder])
  @@index([tenantId])
}

model InsurancePartner {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  slug          String
  logoUrl       String?
  description   String?
  displayOrder  Int             @default(0)
  contentStatus ContentStatus   @default(PUBLISHED)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tenantId      String          @db.Uuid
  tenant        HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([isActive, contentStatus, displayOrder])
  @@index([tenantId])
}

model InternationalPageContent {
  id                 String   @id @default(uuid()) @db.Uuid
  title              String
  introduction       String?
  howToRequest       String?
  secondOpinion      String?
  requiredDocuments  String?
  travelInformation  String?
  accommodationInfo  String?
  coordinatorContact String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  tenantId String          @db.Uuid
  tenant   HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId])
  @@index([tenantId])
}

model HomepageSection {
  id           String              @id @default(uuid()) @db.Uuid
  sectionType  HomepageSectionType
  title        String?
  subtitle     String?
  content      String?
  imageUrl     String?
  displayOrder Int                 @default(0)
  isEnabled    Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tenantId     String              @db.Uuid
  tenant       HospitalProfile     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([isEnabled, displayOrder])
  @@index([tenantId])
}

model MediaAsset {
  id         String    @id @default(uuid()) @db.Uuid
  url        String
  storageKey String?
  isPrivate  Boolean   @default(false)
  altText    String?
  caption    String?
  type       MediaType @default(IMAGE)
  width      Int?
  height     Int?
  fileSize   Int?
  mimeType   String?
  createdAt  DateTime  @default(now())

  tenantId String          @db.Uuid
  tenant   HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, storageKey])
}

model AppointmentEnquiry {
  id                String          @id @default(uuid()) @db.Uuid
  name              String
  email             String
  phone             String
  departmentId      String?         @db.Uuid
  department        Department?     @relation(fields: [departmentId], references: [id])
  preferredDoctorId String?         @db.Uuid
  preferredDoctor   DoctorProfile?  @relation(fields: [preferredDoctorId], references: [id])
  preferredDate     DateTime?       @db.Date
  message           String?
  status            EnquiryStatus   @default(NEW)
  internalNotes     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tenantId          String          @db.Uuid
  tenant            HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([status, createdAt])
  @@index([tenantId])
}

model ContactMessage {
  id        String               @id @default(uuid()) @db.Uuid
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  tenantId  String               @db.Uuid
  tenant    HospitalProfile      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([tenantId])
}

model InternationalPatientEnquiry {
  id                  String          @id @default(uuid()) @db.Uuid
  name                String
  email               String
  phone               String?
  country             String
  treatmentInterest   String?
  preferredDepartment String?
  message             String?
  status              EnquiryStatus   @default(NEW)
  internalNotes       String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  tenantId            String          @db.Uuid
  tenant              HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([tenantId])
}

model PackageInformationRequest {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  email       String
  phone       String?
  packageSlug String?
  packageName String?
  message     String?
  status      EnquiryStatus   @default(NEW)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenantId    String          @db.Uuid
  tenant      HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([tenantId])
}

model Notification {
  id                    String              @id @default(uuid()) @db.Uuid
  tenantId              String              @db.Uuid
  tenant                HospitalProfile     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipientUserId       String              @db.Uuid
  user                  User                @relation(fields: [recipientUserId, tenantId], references: [id, tenantId], onDelete: Cascade)
  appointmentId         String?             @db.Uuid
  appointment           Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  type                  NotificationType
  channel               NotificationChannel
  status                NotificationStatus  @default(PENDING)
  payload               Json?
  scheduledAt           DateTime?
  sentAt                DateTime?
  processingStartedAt   DateTime?
  completedAt           DateTime?
  idempotencyKey        String?             @unique
  attemptCount          Int                 @default(0)
  maxAttempts           Int                 @default(8)
  nextRetryAt           DateTime?
  lastError             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([recipientUserId])
  @@index([status, scheduledAt])
  @@index([status, nextRetryAt])
}

model OtpChallenge {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @db.Uuid
  tenant       HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone        String
  codeHash     String
  expiresAt    DateTime
  attemptCount Int             @default(0)
  maxAttempts  Int             @default(5)
  consumedAt   DateTime?
  ipAddress    String?
  createdAt    DateTime        @default(now())

  @@index([tenantId, phone, createdAt])
  @@index([expiresAt])
}

model AuditLog {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @db.Uuid
  tenant        HospitalProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUserId   String?         @db.Uuid
  actor         User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action        String
  entityType    String
  entityId      String?
  before        Json?
  after         Json?
  correlationId String?
  createdAt     DateTime        @default(now())

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId])
}

model AuthAttempt {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String?         @db.Uuid
  tenant    HospitalProfile? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  kind      String
  success   Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@index([kind, key, createdAt])
  @@index([tenantId, createdAt])
}
