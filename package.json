{
  "name": "hospital-appointment-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5000",
    "build": "next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start -p 5000",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "seed:dev": "tsx prisma/seed.ts",
    "seed:test": "tsx prisma/seed.ts",
    "test": "node scripts/isolated-db.mjs unit -- npx vitest run",
    "test:watch": "node scripts/isolated-db.mjs unit -- npx vitest",
    "test:e2e": "node scripts/isolated-db.mjs e2e -- npx playwright test",
    "test:e2e:twice": "node scripts/isolated-db.mjs e2e-twice",
    "worker:notifications": "tsx src/server/notifications/run-worker.ts",
    "test:load": "k6 run tests/load/scenarios.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@hookform/resolvers": "^5.7.1",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.3.0",
    "@sentry/nextjs": "^10.70.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "next": "^15.5.23",
    "next-auth": "5.0.0-beta.25",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.85.0",
    "recharts": "^3.10.1",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.23",
    "postcss": "^8.4.49",
    "prisma": "^6.3.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
