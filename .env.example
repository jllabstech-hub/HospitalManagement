# Hospital Appointment Management System - Environment Configuration Template

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hospital_db?schema=public"

# Authentication Secrets & Configuration
# Secret key used to sign JWT session cookies (min 32 characters)
AUTH_SECRET="your-super-secret-jwt-key-min-32-chars-change-in-production"

# Application Settings
NODE_ENV="development" # Options: development, production, test
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Timezone Configuration
# Default Hospital Timezone used for slot rendering and booking validation
NEXT_PUBLIC_HOSPITAL_TIMEZONE="Asia/Kolkata"
