# Hospital Appointment Management System - Environment Configuration Template

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hospital_db?schema=public"

# Isolated databases for tests. Never point these at the shared Neon database.
# UNIT_TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/hospital_unit?schema=public"
# E2E_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/hospital_e2e?schema=public"
# Optional Docker alternative: docker compose -f docker-compose.e2e.yml up -d

# Authentication Secrets & Configuration
# Secret key used to sign JWT session cookies (min 32 characters). Required in production.
AUTH_SECRET="your-super-secret-jwt-key-min-32-chars-change-in-production"
NEXTAUTH_URL="http://localhost:5000"

# Application Settings
PORT=5000
NODE_ENV="development" # Options: development, production, test
NEXT_PUBLIC_APP_URL="http://localhost:5000"

# Tenant resolution
# Production never falls back to the first hospital. Localhost may, if enabled.
ALLOW_DEV_TENANT_FALLBACK="true"
DEFAULT_TENANT_DOMAIN="carepulse"

# OTP
# Production never silently authenticates when SMS is unavailable.
# Demo mode is development/test only and still does not return the OTP to the browser.
OTP_DEMO_MODE="true"

# Metrics (required in production; endpoint fails closed without it)
METRICS_TOKEN=""
CRON_SECRET=""

# Object storage (required in production). Local filesystem is forbidden in production.
STORAGE_PROVIDER="s3"
MEDIA_BUCKET=""
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
MEDIA_CDN_HOST=""
# GCS_CLIENT_EMAIL=""
# GCS_PRIVATE_KEY=""

# Timezone Configuration
NEXT_PUBLIC_HOSPITAL_TIMEZONE="Asia/Kolkata"

# Notification providers. Production requires at least email or SMS credentials.
# RESEND_API_KEY=""
# SMTP_HOST=""
# SMTP_USER=""
# SMTP_PASS=""
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+18005550199"

# Optional in-process outbox poller for self-hosted Node (ms). Vercel uses /api/cron/notifications.
# NOTIFICATION_WORKER_POLL_MS="60000"

# Dangerous flags — rejected in production
# ALLOW_DESTRUCTIVE_SEED="false"
# E2E_TEST_MODE="false"
# ALLOW_MOCK_SESSION="false"
# SHOW_DEMO_CREDENTIALS="false"
# RATE_LIMIT_DISABLED="false"
